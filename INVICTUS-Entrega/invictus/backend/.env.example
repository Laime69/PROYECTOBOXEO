# Configuración del backend — Academia de Boxeo Invictus
# Copiar este archivo como ".env" y ajustar los valores según el entorno.

PORT=4000

# Conexión a PostgreSQL (instalación local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambia_este_valor
DB_NAME=invictus_boxeo

# Seguridad JWT — genera uno con: openssl rand -base64 32
JWT_SECRET=genera_un_secreto_aleatorio
JWT_EXPIRES_IN=24h
